# Leave these unset to run the frontend in demo mode with realistic sample
# data — the whole app is fully browsable without a backend or Supabase
# project connected.

# FastAPI backend base URL (see fxpool-backend/app/main.py)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project (see fxpool-backend/app/core/supabase.py — same project
# the backend uses to verify the bearer token)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
